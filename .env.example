# =====================================================================
# Verity — every environment variable, in one place (Implementation_plan.md §17).
# Copy the relevant block to where it is read:
#   backend   -> backend/.env          (FastAPI on Render; also scripts/*.py)
#   frontend  -> frontend/.env.local   (Next.js on Vercel; NEXT_PUBLIC_* are public)
#   programs  -> shell env for programs/verity_core/scripts/*.mjs and scripts/deploy_program.*
#   tests     -> shell env for pytest / CI
# Never commit real values. Keypairs are secrets: keep them in programs/verity_core/keys/
# (gitignored) and in the hosting provider's secret store.
# =====================================================================

# ---------------------------------------------------------------- backend (backend/.env)
SOLANA_RPC_URL=https://api.devnet.solana.com        # or a Helius devnet URL (fewer 429s)
PROGRAM_ID=ByADChPce9hwCuSak9hFwiiCyndYGj7dkYypm4XYEJL1
ZK_PROGRAM_ID=A5taiN69gN4EALtyM9X9S7dVMbhA5qo8aejHrfo48mVv
CLUSTER=devnet
# Keypairs: JSON array of 64 bytes (solana-keygen format) or base64 of the 64 bytes.
PROVIDER_KEYPAIR_JSON=
VERIFIER_KEYPAIRS_JSON=                              # JSON array of 3 keypairs
ADMIN_KEYPAIR_JSON=                                  # config authority (falls back to the provider)
REQUESTER_KEYPAIR_JSON=                              # optional: funds admin-lab demo requests
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                           # server only, bypasses RLS
SUPABASE_JWT_SECRET=
DATABASE_URL=                                        # postgres URL, only for scripts/apply_migrations.py
PINATA_JWT=                                          # optional IPFS pinning (or PINATA_API_KEY + PINATA_API_SECRET)
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY=
FRONTEND_ORIGIN=http://localhost:3000                # comma-separated CORS origins
ADMIN_EMAILS=support@arhamfintech.ai                 # comma-separated
DEV_ADMIN_TOKEN=                                     # local/E2E only: long random admin bearer token; empty when deployed
WORKERS_ENABLED=true                                 # provider / verifier / finalizer / indexer jobs
GROQ_API_KEY=                                        # optional AI explainer
ANTHROPIC_API_KEY=                                   # optional AI explainer

# ---------------------------------------------------------------- frontend (frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=                            # same project as SUPABASE_URL (Realtime + Google auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000            # the FastAPI URL (Render in production)
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=ByADChPce9hwCuSak9hFwiiCyndYGj7dkYypm4XYEJL1
NEXT_PUBLIC_ZK_PROGRAM_ID=A5taiN69gN4EALtyM9X9S7dVMbhA5qo8aejHrfo48mVv
NEXT_PUBLIC_CLUSTER=devnet

# ---------------------------------------------------------------- programs (shell env)
DEPLOYER_KEYPAIR=programs/verity_core/keys/deployer.json   # path; upgrade + config authority
RPC_URL=https://api.devnet.solana.com                # scripts/*.mjs; http://127.0.0.1:8899 for a local validator
PAYROLL_PROGRAM_HASH=                                # sha256 of rulesets/payroll/payroll.wasm, for setup-zk.mjs

# ---------------------------------------------------------------- tests (shell env)
VERITY_TEST_DATABASE_URL=                            # throwaway Postgres for backend/tests/test_audit_db.py
VERITY_E2E=                                          # 1 = run backend/tests/test_adversarial.py against a deployment
VERITY_API_URL=http://localhost:8000
VERITY_ADMIN_TOKEN=                                  # admin Supabase JWT, or DEV_ADMIN_TOKEN
