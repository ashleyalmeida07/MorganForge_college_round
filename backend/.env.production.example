# Settings of the DEPLOYED backend's database, for running the setup scripts against it from your PC:
#   cp .env.production.example .env.production       (gitignored; fill in the PRODUCTION Supabase project)
#   bash:        VERITY_ENV_FILE=.env.production python scripts/apply_migration.py
#   PowerShell:  $env:VERITY_ENV_FILE=".env.production"; python scripts/apply_migration.py
# Values here override backend/.env; anything left out (keypairs, RPC) is taken from backend/.env.
# The Render service itself does NOT read this file: set the same values in the Render dashboard.
SUPABASE_URL=https://<prod-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Project Settings -> Database -> Connection string (session pooler, port 5432, works over IPv4)
DATABASE_URL=postgresql://postgres.<prod-project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
